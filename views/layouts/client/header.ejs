<header class="header">
    <div class="header-left">
        <button id="menu-toggle"><i class="fa-solid fa-bars"></i></button>
        <h1 class="header-title" id="pageTitle">Dashboard</h1>
    </div>
    <div class="header-right">
        <button class="header-icon-btn" title="Notifications"><i class="fa-solid fa-bell"></i></button>
        <div class="user-profile">
            <img src="https://randomuser.me/api/portraits/women/22.jpg" alt="My Profile Picture" id="profileAvatar"
                title="Change profile picture">
            <form id="avatarUploadForm" style="display: none;"><input type="file" id="avatarUploadInput" name="avatar"
                    accept="image/*"></form>
        </div>
    </div>
</header>