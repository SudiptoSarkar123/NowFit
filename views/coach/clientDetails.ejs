<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client Profile - NOWFit</title>
    <!-- All necessary CSS and Libraries -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/coach.css">
    <style>
        .detail-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .detail-header-actions .btn {
            margin-left: 10px;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .kpi-card {
            background: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            text-align: center;
        }

        .kpi-card h4 {
            font-size: 2rem;
            margin: 0 0 5px 0;
            color: var(--primary-color);
        }

        .kpi-card p {
            margin: 0;
            color: var(--text-light);
        }

        .assignment-card {
            margin-bottom: 25px;
        }

        .assignment-list ul {
            list-style: none;
            padding: 0;
        }

        .assignment-list li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #f3f4f6;
        }

        .assignment-list li:last-child {
            border-bottom: none;
        }

        .remove-btn {
            background: #fee2e2;
            color: #ef4444;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
            cursor: pointer;
        }
    </style>
</head>

<body>
    <div class="dashboard-container">
        <%- include('../layouts/coach/sideBar') %>
            <div class="content-wrapper">
                <%- include('../layouts/coach/header') %>
                    <main class="main-content">

                        <!-- =========== CLIENT HEADER =========== -->
                        <div class="detail-header">
                            <div class="client-identity">
                                <img id="clientAvatar" src="/images/placeholder-avatar.png" alt="Client Avatar"
                                    style="width: 60px; height: 60px; border-radius: 50%;">
                                <div>
                                    <h2 id="clientName">Loading...</h2>
                                    <span id="clientStatusPill"></span>
                                </div>
                            </div>
                            <div class="detail-header-actions">
                                <!-- This link now takes the coach to the centralized assignment page -->
                                <a href="/coach/assign-program" class="btn btn-secondary">Assign Programs</a>
                                <button class="btn btn-primary">Send Message</button>
                            </div>
                        </div>

                        <!-- =========== KPI CARDS (Example for future use) =========== -->
                        <div class="kpi-grid">
                            <!-- KPI cards can be populated with data like adherence, last login, etc. -->
                        </div>

                        <!-- =========== ASSIGNED WORKOUT PROGRAMS (an ARRAY) =========== -->
                        <div class="card full-width-card assignment-card">
                            <div class="card-header">
                                <h3>Assigned Workout Programs</h3>
                            </div>
                            <div class="card-body assignment-list">
                                <ul id="workoutProgramList">
                                    <li>Loading...</li>
                                </ul>
                            </div>
                        </div>

                        <!-- =========== ASSIGNED MEAL PLAN (a single OBJECT) =========== -->
                        <div class="card full-width-card assignment-card">
                            <div class="card-header">
                                <h3>Assigned Meal Plan</h3>
                            </div>
                            <div class="card-body assignment-list">
                                <ul id="mealPlanList">
                                    <li>Loading...</li>
                                </ul>
                            </div>
                        </div>

                    </main>
            </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // Get the client's ID from the URL (e.g., /coach/client/the-client-id)
            const pathSegments = window.location.pathname.split('/');
            const clientId = pathSegments[pathSegments.length - 1];

            // --- Master function to fetch and populate all data for this page ---
            function loadClientDetails() {
                if (!clientId) {
                    $('.main-content').html('<h2>Invalid Client ID provided.</h2>');
                    return;
                }

                // Use your "master" API endpoint for fetching a single client's full details
                $.get(`/coach/client/${clientId}`, function (res) {
                    if (res.success) {
                        const clientData = res.data;
                        populateHeader(clientData); // Basic details for the header
                        populateWorkoutList(clientData.assignedWorkoutProgram);
                        populateMealPlan(clientData.assignedMealPlan);
                    } else {
                        alert('Could not load client details.');
                    }
                });
            }

            // --- Helper Functions to populate each section ---
            function populateHeader(details) {
                if (!details) return;
                $('#clientName').text(details.fullName);
                $('#clientStatusPill').text(details.status).attr('class', `status-pill status-${details.status}`);
            }

            function populateWorkoutList(programs = []) {
                const list = $('#workoutProgramList');
                list.empty();

                if (programs && programs.length > 0) {
                    programs.forEach(assignment => {
                        // Important check: make sure the populated programId and its name exist
                        if (assignment.programId && assignment.programId.name) {
                            const itemHtml = `                                            
                        <li>                                                
                            <span><strong>${assignment.programId.name}</strong></span>
                            <!-- The button needs to know the ID of this specific assignment in the array -->
                            <button class="remove-btn remove-workout-btn" data-assignment-id="${assignment.programId._id}" title="Remove Program">Remove</button>
                        </li>`;      
                            list.append(itemHtml);
                        }
                    });
                } else {
                    list.html('<li>No workout programs assigned. <a href="/coach/assign-program">Assign one now.</a></li>');
                }
            }

            function populateMealPlan(plan) {
                const list = $('#mealPlanList');
                list.empty();

                // Check if the plan object and its nested mealPlanId exist
                if (plan && plan.mealPlanId && plan.mealPlanId.name) {
                    const itemHtml = `
                <li>
                    <span><strong>${plan.mealPlanId.name}</strong></span>
                     <!-- This button just needs to know it's removing the meal plan -->
                    <button class="remove-btn remove-meal-btn" data-assignment-id="${plan.mealPlanId._id}" title="Remove Meal Plan">Remove</button>
                </li>`;
                    list.append(itemHtml);
                } else {
                    list.html('<li>No meal plan assigned. <a href="/coach/assign-program">Assign one now.</a></li>');
                }
            }

            // --- Action Event Listeners for Removing Plans ---

            // Delegated listener for removing a workout from the list
            $(document).on('click', '.remove-workout-btn', function () {
                const assignmentId = $(this).data('assignment-id');
                if (!confirm('Are you sure you want to remove this workout program?')) return;

                $.ajax({
                    url: `/coach/clients/${clientId}/unassign-workout`, // Your backend route for this action
                    method: 'POST', // Using POST for actions
                    contentType: 'application/json',
                    data: JSON.stringify({ assignmentId: assignmentId }), // Pass the unique ID of the item in the array
                    success: function (res) {
                        if (res.success) {
                           Swal.fire({
                               icon: 'success',
                               title: 'Program removed successfully!',
                               showConfirmButton: false,
                               timer: 1500
                           })
                           setTimeout(()=>{
                               window.location.href = '/coach/client-details/' + clientId;
                           },1500);
                        } else { alert('Failed to remove program: ' + res.message); }
                    },
                    error: function () { alert('A server error occurred.'); }
                });
            });

            // Listener for removing the single meal plan
            $(document).on('click', '.remove-meal-btn', function () {
                const mealPlanId = $(this).data('assignment-id');
                if (!confirm('Are you sure you want to remove the meal plan?')) return;
                $.ajax({
                    url: `/coach/clients/${clientId}/unassign-meal-plan`,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({assignmentId: mealPlanId}),
                    success: function (res) {
                        if (res.success) {
                            alert('Meal plan removed successfully!');
                            loadClientDetails(); // Reload page data
                        } else { alert('Failed to remove meal plan.'); }
                    },
                    error: function () { alert('A server error occurred.'); }
                });
            });

            // --- Initial Page Load ---
            loadClientDetails();
        });
    </script>
</body>

</html>