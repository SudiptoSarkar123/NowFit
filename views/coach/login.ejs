<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NOWFit - Coach Portal</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style2.css">

    <!-- I've embedded the necessary styles here for a single-file example -->
    <style>
        :root { --primary-color: #4f46e5; --primary-dark: #4338ca; --light-bg: #f3f4f6; --text-dark: #1f2937; --text-light: #6b7280; --card-bg: #ffffff; --white: #ffffff; --border-color: #e5e7eb; --shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
        body { font-family: 'Poppins', sans-serif; background-color: var(--light-bg); color: var(--text-dark); display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .flow-card { background-color: var(--card-bg); border-radius: 16px; box-shadow: var(--shadow); width: 100%; max-width: 500px; overflow: hidden; }
        .flow-header { text-align: center; padding: 40px 40px 20px; }
        .flow-header .logo { font-size: 2.5rem; color: var(--primary-color); margin-bottom: 10px; }
        .flow-header h1 { font-size: 1.8rem; margin-bottom: 5px; }
        .flow-header p { color: var(--text-light); }
        .flow-body { padding: 30px 40px; }
        .form-group { margin-bottom: 25px; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 8px; }
        .form-group input { width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 1rem; }
        .btn { display: block; width: 100%; padding: 14px; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: all 0.3s; }
        .btn-primary { background-color: var(--primary-color); color: var(--white); }
        .btn-primary:hover { background-color: var(--primary-dark); }
        .text-link { text-align: center; margin-top: 20px; }
        .text-link a { color: var(--primary-color); font-weight: 500; text-decoration: none; }
        #errorMessage { color: #ef4444; text-align: center; margin-bottom: 15px; display: none; }
    </style>
</head>
<body>

    <div class="flow-card">
        <div id="loginPage" class="active">
            <div class="flow-header">
                <div class="logo"><i class="fa-solid fa-dumbbell"></i></div>
                <h1>Welcome Back, Coach!</h1>
                <p>Log in to your NOWFit Portal.</p>
            </div>
            <div class="flow-body">
                <!-- A div to show error messages -->
                <div id="errorMessage"></div>
                <form id="loginForm">
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" required>
                    </div>
                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Log In</button>
                    <!-- <div class="text-link"><a href="/forgot-password">Forgot Password?</a></div> -->
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/sweetalert2@11"></script>
    

    <!-- ===== NEW SCRIPT TO HANDLE LOGIN ===== -->
    <script>
        $(document).ready(function() {
            // 1. Listen for the form submission
            $('#loginForm').on('submit', function(e) {
                e.preventDefault(); // Prevent the default browser reload

                // Hide any previous error messages
                $('#errorMessage').hide();

                // 2. Gather the form data
                const loginData = {
                    email: $('#email').val(),
                    password: $('#password').val()
                };

                $.ajax({
                    url: '/auth/coach/login', 
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(loginData),
                    success: function(response) {
                        // 4. Handle a successful response from the server
                        if (response.success) {
                            Swal.fire({
                                icon:'success',
                                title:'Success',
                                text:response.message,
                                timer:1500,
                                showConfirmButton:false
                            })
                           if(response.firstLogin){
                            window.location.href = '/auth/coach/change-password';
                           }else{
                               window.location.href = '/coach/dashboard';
                           }
                        } else {
                            // This case is for unexpected successful responses
                            $('#errorMessage').text('Login succeeded but an error occurred. Please contact support.').show();
                        }
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.error || 'Something went wrong';
                        Swal.fire({
                            icon:'error',
                            title:'Oops...',
                            text:errorMsg
                        })
                    }
                });
            });
        });
    </script>
</body>
</html>