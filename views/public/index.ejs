    <!-- YOUR CUSTOM SCRIPT -->
    <script>
        $(document).ready(function() { // Ensures the DOM is ready before scripts run

            // --- MOBILE NAVIGATION ---
            $('.menu-toggle').on('click', function() {
                $('.nav-links').toggleClass('active');
            });
            $('.nav-links li a').on('click', function() {
                if ($('.nav-links').hasClass('active')) {
                    $('.nav-links').removeClass('active');
                }
            });

            // --- SCROLL REVEAL ANIMATION ---
            const revealElements = document.querySelectorAll('.scroll-reveal');
            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, {
                threshold: 0.1
            });
            revealElements.forEach(el => revealObserver.observe(el));


            // --- JQUERY AJAX FORM SUBMISSION WITH SWEETALERT ---
            $('#enquiry-form').on('submit', function(e) {
                e.preventDefault(); // Prevent default form submission

                const form = $(this);
                const submitBtn = $('#submit-btn');
                const originalBtnHtml = submitBtn.html();

                // 1. Show loading state using jQuery methods
                submitBtn.html('Submitting... <i class="fa-solid fa-spinner fa-spin"></i>');
                submitBtn.prop('disabled', true);

                // 2. Collect form data and convert to a plain JavaScript object
                const formData = new FormData(this);
                const data = Object.fromEntries(formData.entries());

                // 3. Make the API call using jQuery's $.ajax
                $.ajax({
                    url: 'api/admin/enquiries/add', // Your backend route
                    type: 'POST',
                    contentType: 'application/json', // Let the server know we're sending JSON
                    data: JSON.stringify(data),      // Convert the JS object to a JSON string
                    dataType: 'json',                // Expect a JSON response from the server

                    success: function(response) {
                        // --- SUCCESS ---
                        // Show a success popup with SweetAlert2
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: "Your enquiry has been sent. We'll be in touch shortly.",
                            timer: 2500, // Auto-close after 2.5 seconds
                            showConfirmButton: false
                        });
                        form[0].reset(); // Reset the form fields
                    },

                    error: function(jqXHR, textStatus, errorThrown) {
                        // --- FAILURE ---
                        console.error("AJAX Error:", textStatus, errorThrown);
                        // Show an error popup with SweetAlert2
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: 'Something went wrong. Please check your details and try again.',
                        });
                    },
                    
                    complete: function() {
                        // 4. This runs after success or error
                        // Restore the button to its original state
                        submitBtn.html(originalBtnHtml);
                        submitBtn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
